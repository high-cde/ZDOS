{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zdos.example/schemas/zdos-trace-event.v1.json",
  "title": "ZDOS Traceability Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_time", "what", "where", "who", "why", "proof"],
  "properties": {
    "event_id": {"type": "string", "minLength": 8},
    "event_type": {"enum": ["ObjectEvent", "AggregationEvent", "TransformationEvent", "TransactionEvent"]},
    "action": {"enum": ["ADD", "OBSERVE", "DELETE"]},
    "event_time": {"type": "string", "format": "date-time"},
    "event_timezone_offset": {"type": "string", "pattern": "^[+-][0-9]{2}:[0-9]{2}$"},
    "what": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "where": {"type": "string", "minLength": 1},
    "who": {"type": "string", "minLength": 1},
    "why": {"type": "string", "minLength": 1},
    "biz_step": {"type": "string"},
    "disposition": {"type": "string"},
    "source": {"type": "string"},
    "destination": {"type": "string"},
    "kde": {"type": "object", "additionalProperties": true},
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "object_hash", "issuer"],
      "properties": {
        "schema": {"const": "zdos.proof.v1"},
        "object_hash": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
        "issuer": {"type": "string", "minLength": 8}
      }
    }
  }
}
