# ZDOS Linux pseudo-filesystems; persistent data is mounted by /init via UUID.
proc       /proc  proc      nosuid,nodev,noexec                         0 0
sysfs      /sys   sysfs     nosuid,nodev,noexec                         0 0
devtmpfs   /dev   devtmpfs  mode=0755,nosuid                           0 0
tmpfs      /run   tmpfs     mode=0755,nosuid,nodev,noexec              0 0
