#!/bin/sh

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
if command -v mdev >/dev/null 2>&1; then
  mdev -s 2>/run/mdev.log || true
fi
mount -t tmpfs tmpfs /run

hostname zdos
mkdir -p /home/zdos /mnt/data

# Configure the first Ethernet interface when BusyBox provides udhcpc.
if [ -x /bin/udhcpc ] && [ -e /sys/class/net/eth0 ]; then
  /bin/udhcpc -i eth0 -n -q -t 3 >/run/udhcpc.log 2>&1 || true
fi

# Persistent storage v1: only mount the first data volume after verifying the
# UUID supplied by the boot contract. The live image remains usable without it.
cmdline=$(cat /proc/cmdline 2>/dev/null || true)
get_cmdline_value() {
  for argument in $cmdline; do
    case "$argument" in
      "$1"=*) printf '%s\n' "${argument#*=}"; return 0 ;;
    esac
  done
}
data_uuid=$(get_cmdline_value zdos.data_uuid || true)
persistence_test=$(get_cmdline_value zdos.persistence_test || true)
persistence_state=live-only
modprobe_bin=$(command -v modprobe 2>/dev/null || true)
if [ -n "$modprobe_bin" ]; then
  for module in virtio virtio_ring virtio_pci virtio_blk ata_generic ata_piix libata sd_mod mbcache jbd2 ext4; do
    "$modprobe_bin" "$module" 2>/run/persistence-modprobe.log || true
  done
  if command -v mdev >/dev/null 2>&1; then
    mdev -s 2>>/run/mdev.log || true
  fi
fi
blkid_bin=$(command -v blkid 2>/dev/null || true)
persistence_device=
if [ -z "$data_uuid" ]; then
  printf 'ZDOS_PERSISTENCE_NO_UUID\n'
elif [ -z "$blkid_bin" ]; then
  printf 'ZDOS_PERSISTENCE_NO_BLKID\n'
else
  attempt=0
  while [ "$attempt" -lt 50 ] && [ -z "$persistence_device" ]; do
    for candidate in /dev/vda1 /dev/vda /dev/sda1 /dev/sda /dev/hda1 /dev/hda; do
      if [ -b "$candidate" ]; then
        blkid_output=$("$blkid_bin" "$candidate" 2>/run/persistence-blkid.log || true)
        actual_uuid=$(printf '%s\n' "$blkid_output" | sed -n 's/.*UUID="\([^"]*\)".*/\1/p')
        if [ "$actual_uuid" = "$data_uuid" ]; then
          persistence_device="$candidate"
          break
        fi
      fi
    done
    if [ -z "$persistence_device" ]; then
      sleep 0.1
      attempt=$((attempt + 1))
    fi
  done
  if [ -z "$persistence_device" ]; then
    printf 'ZDOS_PERSISTENCE_UUID_MISMATCH\n'
  elif mount "$persistence_device" /mnt/data 2>/run/persistence.log; then
    persistence_state=enabled
    if [ "$persistence_test" = write ]; then
      printf 'ZDOS persistent-storage-v1 marker\n' > /mnt/data/.zdos-persistence-marker
      sync
      printf 'ZDOS_PERSISTENCE_WRITE_OK\n'
    elif [ "$persistence_test" = read ]; then
      if [ "$(cat /mnt/data/.zdos-persistence-marker 2>/dev/null)" = 'ZDOS persistent-storage-v1 marker' ]; then
        printf 'ZDOS_PERSISTENCE_READ_OK\n'
      else
        printf 'ZDOS_PERSISTENCE_READ_FAILED\n'
      fi
    fi
  else
    printf 'ZDOS_PERSISTENCE_MOUNT_FAILED\n'
  fi
fi

printf '\nZDOS Linux 0.2\n'
printf 'Kernel: '; uname -r
printf 'Network: '; ip -brief address 2>/dev/null || printf 'not configured\n'
printf 'Persistence: '; printf '%s\n' "$persistence_state"
printf 'ZDOS_READY\n'

# Automated persistence tests terminate only this ZDOS guest after flushing
# and unmounting the data filesystem. This never powers off the VPS host.
if [ -n "$persistence_test" ] && [ -n "$persistence_device" ]; then
  sync
  umount /mnt/data 2>/run/persistence-umount.log || true
  sync
  if command -v poweroff >/dev/null 2>&1; then
    exec poweroff -f
  elif command -v halt >/dev/null 2>&1; then
    exec halt -f
  fi
fi

exec /bin/sh
